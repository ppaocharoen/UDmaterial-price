rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ผู้ดูแลระบบ = มีเอกสาร access ของตนเองที่ status = approved และ role = admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role == 'admin';
    }

    // ข้อมูลผู้ใช้ (ชื่อ ตำแหน่ง หน่วยงาน): เจ้าของอ่าน/เขียนได้ ผู้ดูแลระบบอ่านได้ทั้งหมด
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // สิทธิ์: เจ้าของอ่านได้ ผู้ดูแลระบบอ่านทั้งหมดและแก้ไขของคนอื่นได้ (แก้ไขของตนเองไม่ได้)
    match /access/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && request.auth.uid != uid;
    }

    // โครงการของผู้ใช้แต่ละคน
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
